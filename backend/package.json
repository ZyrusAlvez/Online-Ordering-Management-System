{
  "name": "online-ordering-management-system-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API backend for the Online Ordering Management System",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --dir=tests/unit",
    "test:integration": "node scripts/run-tests.mjs --dir=tests/integration",
    "test:e2e": "node scripts/run-tests.mjs --dir=tests/e2e",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "seed:accounts": "node --env-file=.env scripts/seed-accounts.mjs",
    "seed:menu": "node supabase/generate-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  }
}

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Runtime mode: development | test | production
NODE_ENV=development
# Port the HTTP server listens on
PORT=4000
# Path prefix every route is mounted under
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (use * to allow any)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# morgan log format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Sliding window length in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests allowed per IP per window
RATE_LIMIT_MAX=300
# How many reverse proxies sit in front of the API (0 if none). It decides whose IP
# the rate limits see: too low and everyone shares one IP, too high and a client
# can fake its address with X-Forwarded-For.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# "publishable" key (sb_publishable_...) — safe for the browser, honours RLS.
# Replaces the legacy "anon" key on newer Supabase projects.
SUPABASE_PUBLISHABLE_KEY=
# "secret" key (sb_secret_...) — BYPASSES Row Level Security. Server only.
# Never expose this to the frontend and never commit it. Replaces the legacy
# "service_role" key.
SUPABASE_SECRET_KEY=
# JWKS endpoint (Project Settings > API > JWT Settings), used to verify user
# access tokens locally without an API round trip per request. Optional.
SUPABASE_JWKS_URL=
# Postgres connection string (Project Settings > Database) — optional, for
# migrations or direct SQL tooling.
DATABASE_URL=

# ---------------------------------------------------------------------------
# PayMongo (GCash) — https://dashboard.paymongo.com/developers
# ---------------------------------------------------------------------------
# Secret key: sk_test_... in test mode, sk_live_... in production.
PAYMONGO_SECRET_KEY=
# Webhook signing secret (whsk_...), from the webhook you register with
# PayMongo pointing at POST /api/v1/webhooks/paymongo
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_URL=https://api.paymongo.com/v1
# Where PayMongo sends the customer back after the GCash redirect.
PUBLIC_APP_URL=http://localhost:5173
KIOSK_RETURN_URL=http://localhost:5173/kiosk/payment-result

# ---------------------------------------------------------------------------
# Employee gates (/cashier and /kiosk)
# ---------------------------------------------------------------------------
# The shared cashier account that /employee/cashier/login signs in to. Its
# Supabase password is the cashier gate password (admins can change it).
CASHIER_EMAIL=cashier@3k.local

# ---------------------------------------------------------------------------
# Test accounts — read by `npm test`.
# Populated automatically by: node --env-file=.env scripts/seed-accounts.mjs
# ---------------------------------------------------------------------------
TEST_ADMIN_PASSWORD=
TEST_CASHIER_PASSWORD=
TEST_KIOSK_PASSWORD=

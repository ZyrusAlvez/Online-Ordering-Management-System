# Supabase project URL and the *publishable* key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key. Server-only: read by src/utils/supabaseAdmin.ts, never sent to the browser.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Each branch's shared cashier login is cashier.<branch code>@<this domain>.
CASHIER_EMAIL=cashier@3k.local

# GCash account customers pay into. Leave GCASH_NUMBER empty to turn GCash off.
NEXT_PUBLIC_GCASH_NAME=
NEXT_PUBLIC_GCASH_NUMBER=
NEXT_PUBLIC_GCASH_QR_IMAGE=/brand/gcash-qr.svg

# Free CARTO Basemaps key for the light map style; without it maps use OpenStreetMap tiles.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# Where the delivery-address map opens before the customer drops a pin (General Mariano Alvarez, Cavite).
NEXT_PUBLIC_MAP_DEFAULT_LAT=14.2985
NEXT_PUBLIC_MAP_DEFAULT_LNG=120.997

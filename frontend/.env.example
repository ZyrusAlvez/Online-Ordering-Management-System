# Backend API base (includes the /api/v1 prefix)
VITE_API_URL=http://localhost:4000/api/v1
# Supabase project URL and the *publishable* key (safe for the browser).
# Never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Free CARTO Basemaps key (request one at https://carto.com/basemaps/apikey) for the
# light map style on every map. Without it the maps use standard OpenStreetMap tiles.
VITE_CARTO_BASEMAPS_KEY=

# Where the delivery-address map opens before the customer drops a pin
# (defaults to General Mariano Alvarez, Cavite).
VITE_MAP_DEFAULT_LAT=14.2985
VITE_MAP_DEFAULT_LNG=120.997
